{
 "uid": "streamlab-services",
 "title": "StreamLab - 2. Microservice Metrics (window results)",
 "description": "The business view: what the aggregator computed for each e-commerce service.",
 "tags": [
  "streamlab"
 ],
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": true,
 "panels": [
  {
   "type": "row",
   "title": "Latest 60s sliding window per service",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "bargauge",
   "title": "Average latency",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "swma_window_avg_latency_ms{window_type=\"sliding\"}",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 250
       },
       {
        "color": "red",
        "value": 500
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "bargauge",
   "title": "Error rate",
   "id": 3,
   "datasource": {
    "type": "prometheus",
